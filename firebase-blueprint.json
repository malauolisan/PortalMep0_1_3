{
  "entities": {
    "news": {
      "title": "Notícias",
      "description": "Notícias e atualizações do movimento.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Título da notícia" },
        "summary": { "type": "string", "description": "Resumo curto" },
        "content": { "type": "string", "description": "Conteúdo completo em Markdown" },
        "image": { "type": "string", "description": "URL da imagem de destaque" },
        "date": { "type": "string", "description": "Data da publicação" },
        "author": { "type": "string", "description": "Nome do autor" },
        "authorId": { "type": "string", "description": "UID do autor" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp de criação" }
      },
      "required": ["title", "content", "date"]
    },
    "events": {
      "title": "Eventos",
      "description": "Agenda de eventos e atividades.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Nome do evento" },
        "description": { "type": "string", "description": "Descrição detalhada" },
        "date": { "type": "string", "description": "Data do evento (ex: 20/05)" },
        "time": { "type": "string", "description": "Horário (ex: 19:30)" },
        "location": { "type": "string", "description": "Localização" },
        "image": { "type": "string", "description": "URL da imagem" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp de criação" }
      },
      "required": ["title", "date", "time", "location"]
    },
    "institutions": {
      "title": "Instituições",
      "description": "Casas espíritas e grupos parceiros.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Nome da instituição" },
        "description": { "type": "string", "description": "História e missão" },
        "image": { "type": "string", "description": "Logo ou foto da sede" },
        "email": { "type": "string", "format": "email", "description": "E-mail de contato" },
        "website": { "type": "string", "format": "uri", "description": "Site oficial" },
        "socials": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string" },
            "facebook": { "type": "string" },
            "twitter": { "type": "string" },
            "youtube": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp de criação" }
      },
      "required": ["name", "description"]
    },
    "articles": {
      "title": "Artigos",
      "description": "Reflexões e estudos doutrinários.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Título do artigo" },
        "subtitle": { "type": "string", "description": "Subtítulo ou resumo" },
        "content": { "type": "string", "description": "Texto completo em Markdown" },
        "author": { "type": "string", "description": "Nome do autor" },
        "authorId": { "type": "string", "description": "UID do autor" },
        "date": { "type": "string", "description": "Data de publicação" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp de criação" }
      },
      "required": ["title", "content", "author", "date"]
    },
    "users": {
      "title": "Usuários",
      "description": "Perfis de administradores e colaboradores.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "colaborador"] },
        "photoURL": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "slides": {
      "title": "Slides",
      "description": "Slides do carrossel da página inicial.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Título do slide" },
        "subtitle": { "type": "string", "description": "Subtítulo do slide" },
        "image": { "type": "string", "description": "URL da imagem de fundo" },
        "link": { "type": "string", "description": "Link de destino (opcional)" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subtitle", "image"]
    },
    "featuredModules": {
      "title": "Módulos em Destaque",
      "description": "Módulos da página inicial (Nossas Instituições, etc).",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Título do módulo" },
        "desc": { "type": "string", "description": "Descrição curta" },
        "img": { "type": "string", "description": "URL da imagem" },
        "color": { "type": "string", "description": "Classe de cor do Tailwind (ex: bg-blue-600)" },
        "link": { "type": "string", "description": "Link de destino" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "desc", "img", "color", "link"]
    }
  },
  "firestore": {
    "/news/{newsId}": { "schema": "news", "description": "Coleção de notícias" },
    "/events/{eventId}": { "schema": "events", "description": "Coleção de eventos" },
    "/institutions/{instId}": { "schema": "institutions", "description": "Coleção de instituições" },
    "/articles/{articleId}": { "schema": "articles", "description": "Coleção de artigos" },
    "/users/{userId}": { "schema": "users", "description": "Perfis de usuários" },
    "/slides/{slideId}": { "schema": "slides", "description": "Slides da home" },
    "/featuredModules/{moduleId}": { "schema": "featuredModules", "description": "Módulos da home" }
  }
}
